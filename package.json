{
  "name": "genio",
  "productName": "Genio",
  "version": "0.1.0",
  "description": "Genio - AI-assisted orchestrator for game development. Talk to one agent, ship with a crew.",
  "main": "./out/main/index.js",
  "author": "Dani",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-install.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "node scripts/check-install.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --dir --publish never",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "perf": "vitest run --config vitest.perf.config.ts",
    "capture": "node scripts/capture.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": false
  },
  "build": {
    "appId": "dev.genio.app",
    "productName": "Genio",
    "directories": { "output": "release" },
    "files": ["out/**/*", "resources/**/*", "package.json"],
    "asar": false,
    "npmRebuild": false,
    "win": { "icon": "resources/icon.ico", "target": "nsis" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Genio" },
    "publish": null
  }
}
